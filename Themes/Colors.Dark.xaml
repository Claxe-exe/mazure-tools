<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <SolidColorBrush x:Key="WindowBrush" Color="#0F1216" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0E12" />
    <SolidColorBrush x:Key="CardBrush" Color="#171B22" />
    <SolidColorBrush x:Key="InputBrush" Color="#1F242E" />
    <SolidColorBrush x:Key="TrackBrush" Color="#262C38" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#2A303B" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B93A1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#06222A" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#16303A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#2A0A0A" />

</ResourceDictionary>
