<Window x:Class="MazureTools.Views.MascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mazu" Width="250" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- One little hop when Mazu is poked. -->
        <Storyboard x:Key="Hop">
            <DoubleAnimation Storyboard.TargetName="HopShift" Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:0.14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <SolidColorBrush x:Key="Ink" Color="#0C4A6E" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= speech bubble -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,0"
                    Visibility="{Binding IsBubbleVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,8" MaxWidth="215">
                <TextBlock Text="{Binding BubbleText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
            </Border>
            <Path Data="M0,0 L14,0 L4,10 Z" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource BorderSoftBrush}"
                  StrokeThickness="1" HorizontalAlignment="Right" Margin="0,-1,44,0" />
        </StackPanel>

        <!-- ================================================= Mazu -->
        <Canvas Grid.Row="1" Width="130" Height="120" HorizontalAlignment="Right" Margin="0,0,14,6"
                Background="Transparent" Cursor="Hand" x:Name="Hit">
            <Canvas.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Tray_Open}" Command="{Binding OpenAppCommand}" />
                    <MenuItem Header="{DynamicResource Mascot_MenuHide}" Command="{Binding HideCommand}" />
                </ContextMenu>
            </Canvas.ContextMenu>

            <!-- ground shadow -->
            <Ellipse Canvas.Left="20" Canvas.Top="106" Width="90" Height="10" Fill="Black" Opacity="0.18" />

            <!-- body + face; squashes gently (low frame rate keeps CPU near zero) -->
            <Canvas Width="130" Height="120" RenderTransformOrigin="0.5,0.9">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="HopShift" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Canvas.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="12" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleY" From="1" To="0.93" Duration="0:0:0.9" />
                                <DoubleAnimation Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleX" From="1" To="1.04" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Canvas.Triggers>

                <!-- slime body -->
                <Path Data="M14,102 C6,72 26,40 52,32 C58,30 62,20 66,12 C70,20 74,30 80,32 C106,40 124,72 116,102 C113,110 17,110 14,102 Z"
                      Stroke="#0284C7" StrokeThickness="1.6" StrokeLineJoin="Round">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#7DD3FC" Offset="0" />
                            <GradientStop Color="#38BDF8" Offset="0.55" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- shine -->
                <Ellipse Canvas.Left="30" Canvas.Top="46" Width="26" Height="13" Fill="White" Opacity="0.55">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-28" CenterX="13" CenterY="6" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="24" Canvas.Top="62" Width="6" Height="6" Fill="White" Opacity="0.5" />

                <!-- ============================ HAPPY -->
                <Canvas Width="130" Height="120" Visibility="{Binding Mood, Converter={StaticResource MoodVisible}, ConverterParameter=Happy}">
                    <Ellipse Canvas.Left="38" Canvas.Top="55" Width="18" Height="22" Fill="White" />
                    <Ellipse Canvas.Left="74" Canvas.Top="55" Width="18" Height="22" Fill="White" />
                    <Ellipse Canvas.Left="41" Canvas.Top="60" Width="12" Height="15" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="77" Canvas.Top="60" Width="12" Height="15" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="44" Canvas.Top="62" Width="5" Height="5" Fill="White" />
                    <Ellipse Canvas.Left="80" Canvas.Top="62" Width="5" Height="5" Fill="White" />
                    <Ellipse Canvas.Left="27" Canvas.Top="80" Width="14" Height="8" Fill="#FDA4AF" Opacity="0.7" />
                    <Ellipse Canvas.Left="89" Canvas.Top="80" Width="14" Height="8" Fill="#FDA4AF" Opacity="0.7" />
                    <Path Data="M55,83 Q65,101 75,83 Z" Fill="{StaticResource Ink}" StrokeLineJoin="Round" Stroke="{StaticResource Ink}" StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="59" Canvas.Top="90" Width="12" Height="6" Fill="#FB7185" />
                </Canvas>

                <!-- ============================ TIRED -->
                <Canvas Width="130" Height="120" Visibility="{Binding Mood, Converter={StaticResource MoodVisible}, ConverterParameter=Tired}">
                    <Path Data="M38,66 A9,11 0 0 0 56,66 Z" Fill="White" />
                    <Path Data="M74,66 A9,11 0 0 0 92,66 Z" Fill="White" />
                    <Ellipse Canvas.Left="43" Canvas.Top="66" Width="7" Height="7" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="79" Canvas.Top="66" Width="7" Height="7" Fill="{StaticResource Ink}" />
                    <Path Data="M36,66 H58 M72,66 H94" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M53,90 Q59,84 65,90 T77,90" Stroke="{StaticResource Ink}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                    <!-- sweat drop -->
                    <Path Data="M106,34 C106,34 99,46 99,51 A7,7 0 0 0 113,51 C113,46 106,34 106,34 Z" Fill="#E0F2FE" Stroke="#0284C7" StrokeThickness="1.2" />
                </Canvas>

                <!-- ============================ WORRIED -->
                <Canvas Width="130" Height="120" Visibility="{Binding Mood, Converter={StaticResource MoodVisible}, ConverterParameter=Worried}">
                    <Ellipse Canvas.Left="38" Canvas.Top="57" Width="18" Height="22" Fill="White" />
                    <Ellipse Canvas.Left="74" Canvas.Top="57" Width="18" Height="22" Fill="White" />
                    <Ellipse Canvas.Left="41" Canvas.Top="58" Width="11" Height="14" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="77" Canvas.Top="58" Width="11" Height="14" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="43" Canvas.Top="60" Width="4" Height="4" Fill="White" />
                    <Ellipse Canvas.Left="79" Canvas.Top="60" Width="4" Height="4" Fill="White" />
                    <Path Data="M36,55 L55,47 M75,47 L94,55" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M57,92 Q65,84 73,92" Stroke="{StaticResource Ink}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                    <Path Data="M22,44 C22,44 17,53 17,57 A5.5,5.5 0 0 0 28,57 C28,53 22,44 22,44 Z" Fill="#E0F2FE" Stroke="#0284C7" StrokeThickness="1.2" />
                </Canvas>

                <!-- ============================ SLEEPY -->
                <Canvas Width="130" Height="120" Visibility="{Binding Mood, Converter={StaticResource MoodVisible}, ConverterParameter=Sleepy}">
                    <Path Data="M38,66 Q47,75 56,66 M74,66 Q83,75 92,66" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                    <Ellipse Canvas.Left="61" Canvas.Top="84" Width="8" Height="9" Stroke="{StaticResource Ink}" StrokeThickness="2.2" Fill="#0369A1" Opacity="0.85" />
                    <Ellipse Canvas.Left="27" Canvas.Top="80" Width="14" Height="8" Fill="#FDA4AF" Opacity="0.5" />
                    <Ellipse Canvas.Left="89" Canvas.Top="80" Width="14" Height="8" Fill="#FDA4AF" Opacity="0.5" />
                    <TextBlock Canvas.Left="98" Canvas.Top="40" Text="z" FontSize="13" FontWeight="Bold" Foreground="#0369A1" />
                    <TextBlock Canvas.Left="106" Canvas.Top="22" Text="Z" FontSize="18" FontWeight="Bold" Foreground="#0369A1" />
                    <TextBlock Canvas.Left="118" Canvas.Top="4" Text="Z" FontSize="13" FontWeight="Bold" Foreground="#0369A1" Opacity="0.7" />
                </Canvas>

                <!-- ============================ SURPRISED -->
                <Canvas Width="130" Height="120" Visibility="{Binding Mood, Converter={StaticResource MoodVisible}, ConverterParameter=Surprised}">
                    <Ellipse Canvas.Left="36" Canvas.Top="52" Width="22" Height="27" Fill="White" />
                    <Ellipse Canvas.Left="72" Canvas.Top="52" Width="22" Height="27" Fill="White" />
                    <Ellipse Canvas.Left="44" Canvas.Top="61" Width="6" Height="8" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="80" Canvas.Top="61" Width="6" Height="8" Fill="{StaticResource Ink}" />
                    <Path Data="M36,46 Q47,38 58,46 M72,46 Q83,38 94,46" Stroke="{StaticResource Ink}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                    <Ellipse Canvas.Left="58" Canvas.Top="84" Width="14" Height="16" Fill="{StaticResource Ink}" />
                    <TextBlock Canvas.Left="101" Canvas.Top="8" Text="?" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" />
                </Canvas>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
