<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:MazureTools.Views"
                    xmlns:vm="clr-namespace:MazureTools.ViewModels"
                    xmlns:sysinfo="clr-namespace:MazureTools.Modules.SystemInfo"
                    xmlns:network="clr-namespace:MazureTools.Modules.Network"
                    xmlns:processes="clr-namespace:MazureTools.Modules.Processes"
                    xmlns:storage="clr-namespace:MazureTools.Modules.Storage"
                    xmlns:utilities="clr-namespace:MazureTools.Modules.Utilities">

    <!-- ViewModel -> View mapping. Navigation just swaps the ViewModel; WPF picks the matching view. -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sysinfo:SystemViewModel}">
        <sysinfo:SystemView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type network:NetworkViewModel}">
        <network:NetworkView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type processes:ProcessesViewModel}">
        <processes:ProcessesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type storage:StorageViewModel}">
        <storage:StorageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type utilities:UtilitiesViewModel}">
        <utilities:UtilitiesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>

    <!-- One disk row, shared by Dashboard, System and Storage pages. -->
    <DataTemplate DataType="{x:Type storage:DiskInfo}">
        <StackPanel Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding FreeAmountText}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{DynamicResource Disk_Free}" Style="{StaticResource Muted}" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7"
                         Value="{Binding UsedPercent, Mode=OneWay}"
                         Foreground="{Binding UsedPercent, Converter={StaticResource PercentToBrush}}" />
            <DockPanel>
                <TextBlock Text="{Binding Details}" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{DynamicResource Disk_UsedOf}" Style="{StaticResource Caption}" Margin="4,0" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
