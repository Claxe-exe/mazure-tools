<UserControl x:Class="MazureTools.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MazureTools.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="{DynamicResource Nav_Dashboard}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding OsText}" Style="{StaticResource Muted}" Margin="0,4,0,22" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:UsageCard Title="{DynamicResource Metric_Cpu}" Margin="0,0,8,0"
                                    ValueText="{Binding Metrics.CpuText}"
                                    Percent="{Binding Metrics.CpuPercent, Mode=OneWay}"
                                    Detail="{Binding CpuName}" />
                <controls:UsageCard Grid.Column="1" Title="{DynamicResource Metric_Memory}" Margin="8,0"
                                    ValueText="{Binding Metrics.MemoryPercentText}"
                                    Percent="{Binding Metrics.MemoryPercent, Mode=OneWay}"
                                    Detail="{Binding Metrics.MemorySummary}" />
                <controls:UsageCard Grid.Column="2" Title="{DynamicResource Metric_Gpu}" Margin="8,0,0,0"
                                    ValueText="{Binding Metrics.GpuText}"
                                    Percent="{Binding Metrics.GpuPercent, Mode=OneWay}"
                                    Detail="{Binding GpuName}"
                                    Note="{Binding Metrics.GpuNote}" />
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_Storage}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Disks}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_Network}" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding NetworkStatus}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding NetworkDetail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_System}" Style="{StaticResource SectionTitle}" />
                            <controls:InfoRow Label="{DynamicResource Info_Windows}" Value="{Binding OsText}" />
                            <controls:InfoRow Label="{DynamicResource Info_Cpu}" Value="{Binding CpuName}" />
                            <controls:InfoRow Label="{DynamicResource Info_Gpu}" Value="{Binding GpuName}" />
                            <controls:InfoRow Label="{DynamicResource Info_Uptime}" Value="{Binding Metrics.UptimeText}" Margin="0,0,0,-10" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
