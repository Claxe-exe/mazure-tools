<UserControl x:Class="MazureTools.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Nav_Settings}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_General}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="{DynamicResource Set_Language}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Language" Content="English" IsChecked="{Binding IsEnglish}" Style="{StaticResource SegmentButton}" />
                        <RadioButton GroupName="Language" Content="Türkçe" IsChecked="{Binding IsTurkish}" Style="{StaticResource SegmentButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Set_LanguageNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,18" />

                    <CheckBox Content="{DynamicResource Set_DarkTheme}" IsChecked="{Binding UseDarkTheme}" />
                    <CheckBox Content="{DynamicResource Set_CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,14,0,0" />
                    <CheckBox Content="{DynamicResource Set_Startup}" IsChecked="{Binding RunAtStartup}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="30,4,0,0"
                               Text="{DynamicResource Set_StartupNote}" />
                    <CheckBox Content="{DynamicResource Set_ShowMascot}" IsChecked="{Binding ShowMascot}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="30,4,0,0"
                               Text="{DynamicResource Set_ShowMascotNote}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_Permissions}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding PrivilegeText}" TextWrapping="Wrap" />
                    <Button Content="{DynamicResource Elev_Button}" Command="{Binding RestartAsAdminCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{DynamicResource Set_NoSilent}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_Data}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DataFolderText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{DynamicResource Set_Internet}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/mazure-logo.png" Width="86" Height="86" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="18,0,0,0" MaxWidth="480">
                        <TextBlock Text="{DynamicResource Set_About}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Set_AboutText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
