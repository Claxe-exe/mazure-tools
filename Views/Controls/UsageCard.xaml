<UserControl x:Class="MazureTools.Views.Controls.UsageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding ValueText, ElementName=Root}" Style="{StaticResource BigValue}" Margin="0,4,0,10" />
            <ProgressBar Style="{StaticResource UsageBar}"
                         Value="{Binding Percent, ElementName=Root, Mode=OneWay}"
                         Foreground="{Binding Percent, ElementName=Root, Converter={StaticResource PercentToBrush}}" />
            <TextBlock Text="{Binding Detail, ElementName=Root}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis" MaxHeight="36" />
            <TextBlock Text="{Binding Note, ElementName=Root}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding Note, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
    </Border>
</UserControl>
