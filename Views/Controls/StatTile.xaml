<UserControl x:Class="MazureTools.Views.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
        <StackPanel>
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</UserControl>
