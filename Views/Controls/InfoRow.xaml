<UserControl x:Class="MazureTools.Views.Controls.InfoRow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 x:Name="Root">
    <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Muted}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
