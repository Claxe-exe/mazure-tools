<Window x:Class="MazureTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Mazure Tools" Width="1120" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/mazure.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================== sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,22,22">
                    <Image Source="pack://application:,,,/Resources/mazure-logo.png" Width="40" Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mazure Tools" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource NavButton}" DataContext="{Binding SettingsPage}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Border Margin="20,10,20,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource InputBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ============================================== page host -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
