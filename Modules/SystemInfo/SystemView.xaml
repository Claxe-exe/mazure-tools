<UserControl x:Class="MazureTools.Modules.SystemInfo.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MazureTools.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="{DynamicResource Sys_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Sys_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,22" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:UsageCard Title="{DynamicResource Metric_Cpu}" Margin="0,0,8,0"
                                    ValueText="{Binding Metrics.CpuText}"
                                    Percent="{Binding Metrics.CpuPercent, Mode=OneWay}"
                                    Detail="{Binding Profile.CpuName}" />
                <controls:UsageCard Grid.Column="1" Title="{DynamicResource Metric_Memory}" Margin="8,0"
                                    ValueText="{Binding Metrics.MemoryPercentText}"
                                    Percent="{Binding Metrics.MemoryPercent, Mode=OneWay}"
                                    Detail="{Binding Metrics.MemorySummary}" />
                <controls:UsageCard Grid.Column="2" Title="{DynamicResource Metric_Gpu}" Margin="8,0,0,0"
                                    ValueText="{Binding Metrics.GpuText}"
                                    Percent="{Binding Metrics.GpuPercent, Mode=OneWay}"
                                    Detail="{Binding GpuNames}"
                                    Note="{Binding Metrics.GpuNote}" />
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Sys_Computer}" Style="{StaticResource SectionTitle}" />
                        <controls:InfoRow Label="{DynamicResource Sys_ComputerName}" Value="{Binding Profile.MachineName}" />
                        <controls:InfoRow Label="{DynamicResource Info_Windows}" Value="{Binding Profile.OsName}" />
                        <controls:InfoRow Label="{DynamicResource Sys_Version}" Value="{Binding Profile.OsVersion}" />
                        <controls:InfoRow Label="{DynamicResource Sys_Architecture}" Value="{Binding Profile.Architecture}" />
                        <controls:InfoRow Label="{DynamicResource Info_Cpu}" Value="{Binding Profile.CpuName}" />
                        <controls:InfoRow Label="{DynamicResource Sys_LogicalProcessors}" Value="{Binding Profile.LogicalProcessors}" />
                        <controls:InfoRow Label="{DynamicResource Info_Gpu}" Value="{Binding GpuNames}" />
                        <controls:InfoRow Label="{DynamicResource Info_Uptime}" Value="{Binding Metrics.UptimeText}" Margin="0,0,0,-10" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Sys_Memory}" Style="{StaticResource SectionTitle}" />
                            <controls:InfoRow Label="{DynamicResource Sys_Total}" Value="{Binding Metrics.MemoryTotalText}" />
                            <controls:InfoRow Label="{DynamicResource Sys_Used}" Value="{Binding Metrics.MemoryUsedText}" />
                            <controls:InfoRow Label="{DynamicResource Sys_Free}" Value="{Binding Metrics.MemoryFreeText}" Margin="0,0,0,-10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Sys_Disks}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Disks}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
