<UserControl x:Class="MazureTools.Modules.Storage.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <DockPanel>
                <Button Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stor_Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{DynamicResource Stor_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,22" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stor_Disks}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Disks}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stor_FolderSize}" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="{DynamicResource Common_Browse}" Command="{Binding BrowseCommand}" />
                            <Button Content="{DynamicResource Stor_Calculate}" Command="{Binding CalculateCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBool}}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ResultText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{DynamicResource Stor_Note}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
