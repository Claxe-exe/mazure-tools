<UserControl x:Class="MazureTools.Modules.Utilities.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:MazureTools.Modules.Utilities">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="{DynamicResource Nav_Utilities}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Util_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,22" />

            <!-- ============================================ launchers -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Launchers}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Util_QuickLaunch}" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Util_Cmd}" Command="{Binding OpenCmdCommand}" />
                        <Button Content="{DynamicResource Util_PowerShell}" Command="{Binding OpenPowerShellCommand}" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource Util_Explorer}" Command="{Binding OpenExplorerCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding PrivilegeNote}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ============================================ port checker -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Port}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Port_Title}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ping_Host}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Port_Port}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,10,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{DynamicResource Port_Check}" Command="{Binding CheckCommand}"
                                Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding Result}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Result, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static util:PortState.Open}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static util:PortState.Closed}">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static util:PortState.TimedOut}">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{DynamicResource Port_Note}" />
                </StackPanel>
            </Border>

            <!-- ============================================ hash -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Hash}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Hash_Title}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="{DynamicResource Hash_File}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="{DynamicResource Common_Browse}" Command="{Binding BrowseCommand}" />
                            <Button Content="{DynamicResource Hash_HashFile}" Command="{Binding HashFileCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                            <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,0" Height="4"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{DynamicResource Hash_Text}" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Hash_HashText}" Command="{Binding HashTextCommand}" Margin="10,0,0,0" />
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SourceCaption}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="SHA-256" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <TextBox Grid.Column="1" Text="{Binding Sha256, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="SHA-1" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sha1, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="MD5" Style="{StaticResource Muted}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Md5, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Hash_Compare}" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Comparison}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{DynamicResource Hash_Warn}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
