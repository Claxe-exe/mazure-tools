<UserControl x:Class="MazureTools.Modules.Network.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MazureTools.Views.Controls"
             xmlns:net="clr-namespace:MazureTools.Modules.Network">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type net:NetworkAdapterInfo}">
            <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,4">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                        <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUp}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="19,2,0,10" />
                    <Grid Margin="19,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <controls:InfoRow Label="{DynamicResource Ad_Type}" Value="{Binding Type}" />
                            <controls:InfoRow Label="{DynamicResource Ad_Mac}" Value="{Binding MacAddress}" />
                            <controls:InfoRow Label="{DynamicResource Ad_Speed}" Value="{Binding Speed}" />
                            <controls:InfoRow Label="{DynamicResource Ad_Dhcp}" Value="{Binding DhcpText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <controls:InfoRow Label="{DynamicResource Ad_IPv4}" Value="{Binding IPv4Text}" />
                            <controls:InfoRow Label="{DynamicResource Ad_IPv6}" Value="{Binding IPv6Text}" />
                            <controls:InfoRow Label="{DynamicResource Net_Gateway}" Value="{Binding GatewayText}" />
                            <controls:InfoRow Label="{DynamicResource Net_Dns}" Value="{Binding DnsText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <DockPanel>
                <Button Content="{DynamicResource Common_Refresh}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource Net_Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{DynamicResource Net_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,22" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Net_Connection}" Style="{StaticResource SectionTitle}" />
                        <controls:InfoRow Label="{DynamicResource Net_Status}" Value="{Binding ConnectionText}" />
                        <controls:InfoRow Label="{DynamicResource Net_ActiveAdapter}" Value="{Binding ActiveAdapter}" />
                        <controls:InfoRow Label="{DynamicResource Net_LocalIp}" Value="{Binding LocalIp}" />
                        <controls:InfoRow Label="{DynamicResource Net_Gateway}" Value="{Binding Gateway}" />
                        <controls:InfoRow Label="{DynamicResource Net_Dns}" Value="{Binding DnsServers}" />
                        <DockPanel>
                            <Button Content="{DynamicResource Net_LookUp}" Command="{Binding FetchPublicIpCommand}" DockPanel.Dock="Right"
                                    Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Top" />
                            <controls:InfoRow Label="{DynamicResource Net_PublicIp}" Value="{Binding PublicIp}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Net_PublicIpNote}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Net_Maintenance}" Style="{StaticResource SectionTitle}" />
                        <Button Content="{DynamicResource Net_FlushDns}" Command="{Binding FlushDnsCommand}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                                   Text="{DynamicResource Net_FlushDnsDesc}" />
                        <Button Content="{DynamicResource Net_RenewIp}" Command="{Binding RenewIpCommand}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                                   Text="{DynamicResource Net_RenewIpDesc}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Net_MaintNote}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel DataContext="{Binding Ping}">
                    <TextBlock Text="{DynamicResource Ping_Title}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ping_Host}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" Margin="0,0,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Ping_Count}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" Width="64"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" Margin="0,0,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="{DynamicResource Ping_Start}" Command="{Binding StartCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="{DynamicResource Common_Stop}" Command="{Binding StopCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="6" Margin="0,16,-8,0">
                        <controls:StatTile Label="{DynamicResource Ping_Sent}" Value="{Binding Sent}" />
                        <controls:StatTile Label="{DynamicResource Ping_Received}" Value="{Binding Received}" />
                        <controls:StatTile Label="{DynamicResource Ping_Loss}" Value="{Binding Lost}" />
                        <controls:StatTile Label="{DynamicResource Ping_Min}" Value="{Binding Min}" />
                        <controls:StatTile Label="{DynamicResource Ping_Avg}" Value="{Binding Avg}" />
                        <controls:StatTile Label="{DynamicResource Ping_Max}" Value="{Binding Max}" />
                    </UniformGrid>

                    <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Margin="0,8,0,0">
                        <ScrollViewer x:Name="PingScroll" Height="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="12,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Net_Adapters}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Adapters}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
